{
  "schema_version": 2,
  "direction": "Content-led editorial tree-care site: substantial service information, bold compact typography, one tall split-hero image, quiet warm surfaces and numbered service rows.",
  "layout": {
    "composition": "symmetric",
    "container_width": 1240
  },
  "navigation": {
    "position": "sticky",
    "surface": "solid",
    "logo": "left",
    "cta": true,
    "mobile": "menu"
  },
  "hero": {
    "layout": "split",
    "alignment": "left",
    "height": 640,
    "overlay": 0.55,
    "image_fit": "cover"
  },
  "colors": {
    "background": "#F6F5F0",
    "text": "#24372D",
    "surface": "#E9EDE6",
    "accent": "#24372D",
    "on_accent": "#FFFFFF"
  },
  "typography": {
    "heading_family": "sans",
    "body_family": "sans",
    "heading_size": 88,
    "heading_weight": 700,
    "heading_line_height": 1.02,
    "heading_case": "none",
    "body_size": 18,
    "body_line_height": 1.6
  },
  "spacing": {
    "section": 88,
    "gutter": 32,
    "gap": 40
  },
  "components": {
    "cards": "none",
    "button": "solid",
    "radius": 0,
    "columns": 3
  },
  "motion": {
    "reveal": "fade",
    "hover": "lift",
    "duration": 300,
    "parallax": false
  },
  "responsive": {
    "stack_at": 980,
    "heading_size": 52,
    "section_spacing": 56,
    "gutter": 22,
    "image_height": 360,
    "image_order": "after"
  },
  "sections": [
    {
      "type": "hero",
      "layout": "rows",
      "width": "contained",
      "tone": "base"
    },
    {
      "type": "facts",
      "layout": "rows",
      "width": "contained",
      "tone": "base"
    },
    {
      "type": "services",
      "layout": "rows",
      "width": "contained",
      "tone": "base"
    },
    {
      "type": "about",
      "layout": "split",
      "width": "contained",
      "tone": "surface"
    },
    {
      "type": "process",
      "layout": "grid",
      "width": "contained",
      "tone": "base"
    },
    {
      "type": "faq",
      "layout": "rows",
      "width": "contained",
      "tone": "base"
    },
    {
      "type": "contact",
      "layout": "split",
      "width": "contained",
      "tone": "surface"
    }
  ],
  "reference_influences": [
    {
      "principle": "Editorial hierarchy and edge-aligned composition",
      "evidence": "Measured large reference headings, wide media and generous section rhythm.",
      "implementation": "Original split hero, 88px display type, 88px section spacing; preserve all supplied content sections."
    }
  ]
}
